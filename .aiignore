# .aiignore — материалы, которые не следует передавать ИИ-ассистентам
#
# ВНИМАНИЕ. Этот файл — декларация намерения, а не техническая защита.
# Единого стандарта .aiignore не существует, и большинство инструментов
# (включая Claude Code) его не читают. Реальное ограничение задаётся
# в .claude/settings.json через permissions.deny — см. рядом.
#
# Настоящая гарантия одна: не класть конфиденциальное в рабочий каталог.

# Каталоги с закрытыми материалами
private/
confidential/
internal/
secrets/

# Учётные данные и ключи
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
.env
.env.*
credentials.*
*_rsa
*_ed25519

# Выгрузки и дампы, где легко проносится лишнее
*.dump
*.sql
dumps/
