#!/bin/sh
# Гейт продуктовых имён перед коммитом.
#
# Живёт в tools/hooks, а не в .git/hooks, потому что .git/hooks
# не версионируется: хук, о котором знает только одна машина,
# защищает только эту машину. Подключается один раз командой
#     git config core.hooksPath tools/hooks
#
# Проверяются ТОЛЬКО staged-файлы: полный проход по дереву занимает
# заметное время, и коммит, который тормозит, отключают.
#
# Обойти сознательно: git commit --no-verify. Это должно быть
# осознанным действием, а не привычкой.

python tools/check_names.py || exit 1
